# Template for the runtime secrets. Copy to `.env` **on the Pi only**, in ~/apps/portfolio (the
# checkout root, next to docker-compose.yml), fill both values in, and `chmod 600 .env`.
#
# `.gitignore` covers `.env` so it cannot be committed, and `.dockerignore` excludes it so it cannot
# enter the image. Both values are read at *runtime*, never as build args — so rotating either one is
# `docker compose up -d`, not a rebuild.
#
# Write the values unquoted, one per line, no spaces around `=`. docker-compose.yml interpolates them
# with `${VAR:?...}`, so a missing or empty value fails `docker compose up` loudly instead of starting
# a half-working stack.

# GitHub PAT (classic or fine-grained) with read access to public repo data — that is all the two
# /api/github-* routes need. Absent, those routes 503 and the client falls back to the committed
# static/github-*.json: the site works, but the contribution chart is frozen at the last CI refresh.
GH_TOKEN=

# Connector token for the portfolio's OWN Cloudflare tunnel — Zero Trust → Networks → Tunnels, the
# "docker" install snippet. It must be a NEW tunnel, not the one already serving
# music.mario-belmonte.com: ingress rules are per-tunnel and a second connector on that token would
# make a fraction of music requests fail at random. See PI-HOSTING-PLAN.md Phase 3, trap 1.
TUNNEL_TOKEN=
