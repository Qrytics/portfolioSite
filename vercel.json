{
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=63072000; includeSubDomains; preload"
				},
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{ "key": "X-Frame-Options", "value": "SAMEORIGIN" },
				{ "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
				{
					"key": "Permissions-Policy",
					"value": "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
				}
			]
		},
		{
			"source": "/(.*\\.(?:[pP][nN][gG]|[jJ][pP][eE]?[gG]|[gG][iI][fF]|[wW][eE][bB][pP]|[aA][vV][iI][fF]|[sS][vV][gG]|[iI][cC][oO]|[mM][pP]4|[wW][eE][bB][mM]|[mM][pP]3|[wW][aA][vV]|[oO][gG][gG]|[wW][oO][fF][fF]2?|[tT][tT][fF]|[oO][tT][fF]))",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/(github-(?:contrib|recent)\\.json)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=300, s-maxage=1800, stale-while-revalidate=86400"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/games/spotifyHero/_next/:path*",
			"destination": "https://spotifyhero-web.vercel.app/games/spotifyHero/_next/:path*"
		},
		{
			"source": "/games/spotifyHero",
			"destination": "https://spotifyhero-web.vercel.app/games/spotifyHero"
		},
		{
			"source": "/games/spotifyHero/",
			"destination": "https://spotifyhero-web.vercel.app/games/spotifyHero"
		},
		{
			"source": "/games/spotifyHero/:path*",
			"destination": "https://spotifyhero-web.vercel.app/games/spotifyHero/:path*"
		},
		{
			"source": "/games/vcKaraoke",
			"destination": "https://vckaraoke-frontend.vercel.app/"
		},
		{
			"source": "/games/vcKaraoke/",
			"destination": "https://vckaraoke-frontend.vercel.app/"
		},
		{
			"source": "/games/vcKaraoke/:path*",
			"destination": "https://vckaraoke-frontend.vercel.app/:path*"
		},
		{
			"source": "/room/:path*",
			"destination": "https://vckaraoke-frontend.vercel.app/room/:path*"
		},
		{
			"source": "/tutoring",
			"destination": "https://tutoring.mario-belmonte.com/tutoring/"
		},
		{
			"source": "/tutoring/",
			"destination": "https://tutoring.mario-belmonte.com/tutoring/"
		},
		{
			"source": "/tutoring/:path*",
			"destination": "https://tutoring.mario-belmonte.com/tutoring/:path*"
		},
		{
			"source": "/_next/:path*",
			"destination": "https://vckaraoke-frontend.vercel.app/_next/:path*"
		}
	]
}
